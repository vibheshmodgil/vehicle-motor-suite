      "unit": "rpm",
      "inputs": [
        "peak_power",
        "peak_torque"
      ],
      "output": true,
      "calculation_source": "(P/T)*60/(2π)",
      "code_location": "vmi/torque_force.py:plot_torque_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "peak_motor_torque_curve",
      "description": "Peak motor torque against RPM, from theoretical envelope or uploaded curve, then optional battery cap.",
      "unit": "N m",
      "inputs": [
        "peak_torque",
        "peak_power",
        "motor_rpm",
        "motor_curve",
        "batt_voltage",
        "batt_current_limit"
      ],
      "output": true,
      "calculation_source": "T_peak below base RPM else P/ω; uploaded curve interpolated",
      "code_location": "vmi/torque_force.py:plot_torque_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "continuous_motor_torque_curve",
      "description": "Continuous torque plateau and power cap (uploaded curve can be scaled by ratio).",
      "unit": "N m",
      "inputs": [
        "peak_torque",
        "peak_to_rated_torque_ratio",
        "continuous_power",
        "motor_rpm",
        "motor_curve"
      ],
      "output": true,
      "calculation_source": "min(T_peak/ratio, P_cont/ω)",
      "code_location": "vmi/torque_force.py:plot_force_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "wheel_torque",
      "description": "Motor shaft torque after gearing.",
      "unit": "N m",
      "inputs": [
        "motor_torque",
        "gear_ratio",
        "gear_efficiency"
      ],
      "output": true,
      "calculation_source": "T_m*G*eta_gear",
      "code_location": "vmi/torque_force.py:plot_torque_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "tractive_force",
      "description": "Available wheel force.",
      "unit": "N",
      "inputs": [
        "wheel_torque",
        "wheel_radius"
      ],
      "output": true,
      "calculation_source": "T_w/r",
      "code_location": "vmi/torque_force.py:plot_force_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "road_load_force",
      "description": "Rolling, aerodynamic and grade resistance.",
      "unit": "N",
      "inputs": [
        "m_i",
        "Crr",
        "CdA",
        "vehicle_speed",
        "gradient"
      ],
      "output": true,
      "calculation_source": "m g Crr cos(theta)+0.5*1.225*CdA*v²+m g sin(theta)",
      "code_location": "vmi/parametric.py:_compute_resistive_force",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "force_intersections",
