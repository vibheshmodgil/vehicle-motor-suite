        "road_load_force",
        "gradient"
      ],
      "output": true,
      "calculation_source": "grade search; max(force-road load)>=0",
      "code_location": "vmi/enhancements.py:_report_vehicle_capability; vmi/parametric.py:_estimate_max_gradability",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
