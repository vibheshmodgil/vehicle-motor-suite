      "output": true,
      "calculation_source": "Pdc=Vdc*Idc; Pshaft<=Pdc*eta",
      "code_location": "vmi/ui_helpers.py:cap_torque_to_battery; vmi/calc_ext.py:battery_power_cap_w",
