      "unit": "ratio",
      "inputs": [
        "m_ref",
        "rear_load_ratio",
        "crr"
      ],
      "output": true,
      "calculation_source": "manual or lookup a/(m_i*rear_load_ratio*g)",
      "code_location": "vmi/physics.py:calculate_crr_cd_a",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
