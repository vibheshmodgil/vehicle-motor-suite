      "unit": "m²",
      "inputs": [
        "m_ref",
        "ambient_temp",
        "ambient_pressure",
        "cd_a"
      ],
      "output": true,
      "calculation_source": "manual or mass-table estimate",
      "code_location": "vmi/physics.py:calculate_crr_cd_a",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
      "parameter": "motor_rpm",
      "description": "Motor speed corresponding to vehicle speed.",
      "unit": "rpm",
      "inputs": [
        "vehicle_speed",
        "wheel_radius",
        "gear_ratio"
      ],
      "output": true,
      "calculation_source": "v/(2πr)*60*G",
      "code_location": "vmi/torque_force.py:_accel_wheel_force_fn",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
