      "inputs": [
        "tractive_force",
        "road_load_force",
        "gradients"
      ],
      "output": true,
      "calculation_source": "linear interpolation of curve crossings",
      "code_location": "vmi/torque_force.py:plot_force_graph",
      "dependencies": [
        "numpy",
        "uploaded motor curve optional",
        "motor/controller efficiency maps optional"
      ],
      "relevant_documentation_or_reference": "docs/VMI_User_Guide.html"
    },
    {
      "feature": "powertrain",
